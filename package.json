{
  "name": "skype-clone",
  "version": "1.0.0",
  "description": "A full-featured Skype-like application with video calling, messaging, and payment integration",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=@skype-clone/backend",
    "build:web": "npm run build --workspace=@skype-clone/web",
    "build:mobile": "npm run build --workspace=@skype-clone/mobile",
    "build:desktop": "npm run build --workspace=@skype-clone/desktop",
    "dev": "npm run dev --workspaces",
    "dev:backend": "npm run dev --workspace=@skype-clone/backend",
    "dev:web": "npm run dev --workspace=@skype-clone/web",
    "dev:mobile": "npm run dev --workspace=@skype-clone/mobile",
    "dev:desktop": "npm run dev --workspace=@skype-clone/desktop",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces",
    "validate:env": "node scripts/validate-env.js",
    "test:orchestrate": "node scripts/test-orchestrator.js",
    "test:coverage": "npm run test:orchestrate && npm run test:report",
    "test:report": "nyc report --reporter=html --reporter=text",
    "perf:test": "node scripts/performance-test.js",
    "perf:auth": "npx artillery run performance/auth-load-test.yml",
    "perf:messaging": "npx artillery run performance/messaging-load-test.yml",
    "perf:report": "node scripts/generate-perf-report.js",
    "release:check": "node scripts/release-checklist.js check",
    "release:deploy": "node scripts/release-checklist.js deploy",
    "release:rollback": "node scripts/release-checklist.js rollback",
    "release:full": "node scripts/release-checklist.js full",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose --profile production up --build -d",
    "docker:down": "docker-compose down -v",
    "agent:1": "node scripts/agents/agent1.js",
    "agent:2": "node scripts/agents/agent2.js",
    "agent:3": "node scripts/agents/agent3.js",
    "agent:4": "node scripts/agents/agent4.js"
  },
  "keywords": [
    "skype",
    "video-calling",
    "messaging",
    "webrtc",
    "react",
    "react-native",
    "electron",
    "stripe"
  ],
  "author": "Skype Clone Team",
  "license": "MIT"
}
