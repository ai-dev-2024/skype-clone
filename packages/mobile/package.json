{
  "name": "@skype-clone/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "React Native mobile application for Skype Clone",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "dev": "react-native start",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace SkypeClone.xcworkspace -scheme SkypeClone -configuration Release -sdk iphoneos -archivePath build/SkypeClone.xcarchive archive",
    "clean": "cd android && ./gradlew clean && cd ../ios && rm -rf build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.3",
    "@react-native-community/netinfo": "^9.4.1",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/native-stack": "^6.9.13",
    "@react-navigation/stack": "^7.4.8",
    "@react-native-firebase/app": "^18.3.0",
    "@react-native-firebase/messaging": "^18.3.0",
    "react": "18.2.0",
    "react-native": "0.72.4",
    "react-native-gesture-handler": "^2.12.1",
    "react-native-reanimated": "^3.4.2",
    "react-native-safe-area-context": "^4.7.2",
    "react-native-screens": "^3.24.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-webrtc": "^111.0.3",
    "react-native-image-picker": "^7.0.3",
    "react-native-permissions": "^3.10.1",
    "react-native-push-notification": "^8.1.1",
    "socket.io-client": "^4.7.2",
    "@skype-clone/shared": "*",
    "axios": "^1.5.0",
    "jwt-decode": "^4.0.0",
    "react-native-elements": "^3.4.3",
    "react-native-paper": "^5.10.4",
    "react-native-modal": "^13.0.1",
    "react-native-uuid": "^2.0.1",
    "react-native-get-random-values": "^1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native/tsconfig.json": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "^0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^4.8.4",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0"
  },
  "engines": {
    "node": ">=16"
  }
}
